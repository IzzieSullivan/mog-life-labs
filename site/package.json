    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cypress": "^15.18.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "start-server-and-test": "^3.0.11",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
